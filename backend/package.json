{
  "name": "cyclonedx-assessors-studio-backend",
  "version": "0.6.1",
  "description": "CycloneDX Assessors Studio Backend",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "db:reset": "rm -rf data/pglite && echo 'Database reset. It will be recreated on next server start.'",
    "test": "vitest",
    "test:run": "vitest run; EXIT_CODE=$?; rm -rf ../data/pglite-test-* ../data/pglite-http-test-*; exit $EXIT_CODE",
    "posttest": "rm -rf ../data/pglite-test-* ../data/pglite-http-test-*",
    "encrypt-secrets": "tsx src/scripts/encrypt-secrets.ts",
    "rotate-encryption-key": "tsx src/scripts/rotate-encryption-key.ts",
    "rekey-master": "tsx src/scripts/rekey-master.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1029.0",
    "@cyclonedx/sign": "0.4.0",
    "@electric-sql/pglite": "0.4.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "argon2": "0.44.0",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.1",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "kysely": "0.28.17",
    "nodemailer": "10.2.1",
    "pdfkit": "0.18.0",
    "pg": "8.20.0",
    "prom-client": "15.1.3",
    "uuid": "14.0.0",
    "winston": "3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.5.2",
    "@types/nodemailer": "8.0.0",
    "@types/pdfkit": "0.17.5",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.4",
    "fast-uri": "3.1.9",
    "qs": "6.16.1",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12"
  }
}
