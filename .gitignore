**/stryker.log

# Local admin-reset output (generated credentials — never commit)
.admin-reset/

# Compose secrets created by deploy/docker/init-secrets.sh
deploy/docker/secrets/
deploy/docker/backups/

# Vite/vitest cache
**/.vite/
